{
  "dataset": "cifar10",
  "backbone": "small_cnn",
  "data_root": "./data",
  "output_dir": "./results/robust_iid_v1",
  "seed": 1,
  "image_size": 32,
  "num_clients": 5,
  "target_client": 0,
  "client_fraction": 1.0,
  "rounds": 20,
  "batch_size": 64,
  "local_epochs": 1,
  "learning_rate": 0.05,
  "momentum": 0.9,
  "poison_fraction": 0.8,
  "validation_fraction": 0.1,
  "partition": "iid",
  "dirichlet_alpha": 0.5,
  "unlearning_rounds": 3,
  "recovery_rounds": 3,
  "unlearning_lr": 0.0004,
  "recovery_lr": 0.000001,
  "fine_tune_rounds": 3,
  "fedup_epochs": 30,
  "fedup_centroids_per_class": 4,
  "fedup_features_per_client": 256,
  "maverick_epochs": 3,
  "maverick_noise_samples": 4,
  "fastfedul_alpha": 0.07,
  "fastfedul_theta": 1.0,
  "ledger_dtype": "float16",
  "max_train_samples": 10000,
  "max_test_samples": 10000
}
